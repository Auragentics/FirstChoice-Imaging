# First Choice Imaging — Net Sapiens API bridge
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

# Full API base, including the version prefix, NO trailing slash.
NS_API_BASE=https://api.ucaasnetwork.com/ns-api/v2

# Full 60-character domain-scoped API key (starts with nsd_).
# SECRET — put the real value only in .env, never in .env.example.
NS_API_KEY=nsd_replace_me

# FCI Net Sapiens domain / tenant.
NS_DOMAIN=fci.36350.service

# Voicemail mailbox extension(s) that receive scheduling callback VMs.
# Tentative: the queue forwards no-answer calls to voicemail ext 2002.
# Confirm the real mailbox user with:  npm run probe -- --caller <n> --raw
NS_MAILBOXES=2002

# Call-queue extension whose queued-call list INCLUDES "Waiting for Callback"
# entries — this is our PRIMARY repeat-caller signal.
NS_QUEUE=2002

# --- Webhook server (src/server.js) ---
# Port the bridge listens on.
PORT=8787
# Shared secret the voice AI must send as the x-bridge-secret header.
# Leave blank to disable the check (dev only).
BRIDGE_SHARED_SECRET=
# Hard cap on the live lookup so we never stall a phone call (ms).
# Signals run concurrently, so this is ~the slowest single API call + headroom.
LOOKUP_TIMEOUT_MS=1500
# Voicemail PRESENCE cap + CDR history window (hours). Deflection is presence-based:
# a VM still sitting in mailbox new/trash means the request is still PENDING (staff
# delete VMs when they handle them). This just caps how old a still-present VM can
# be before we ignore it — a safety net against a straggler, set to 3 days.
LOOKBACK_HOURS=72
# Fast-VM CDR signal window (minutes): covers ONLY the mailbox indexing lag, so a
# just-left VM is caught before the mailbox lists it. Keep short (a few minutes).
VM_CDR_WINDOW_MIN=15
# Treat a "Queue Callback" dispatch within this many minutes as an active
# callback (covers the brief window where a dispatched callback leaves the queue
# before connecting). Keep SHORT: too long re-deflects a caller who already got
# their callback, missed it, and is calling back to reach staff (a false
# deflection). 5 min covers the real dispatch gap without that tail.
CALLBACK_WINDOW_MIN=5

# --- Attorney intake (/attorney-intake) ---
# Email transport: "dryrun" (sends nothing, logs no PHI) or "smtp".
EMAIL_MODE=dryrun

# Destination routing by request type (production):
INTAKE_EMAIL_RECORDS=medicalrecords@firstchoice-imaging.com
INTAKE_EMAIL_LIEN=office@firstchoice-imaging.com
# TESTING: if set, ALL intake mail goes here (overrides the two above).
# Leave blank for production.
INTAKE_EMAIL_OVERRIDE=brianlrandall@auragentics.ai

# --- GHL Voice AI prompt deploy (src/deploy-prompts.js) ---
# Pushes the repo prompt .md files into the GHL-native Voice AI agents.
# Base host for the GHL API (no trailing slash).
GHL_API_BASE=https://services.leadconnectorhq.com
# Sub-Account Private Integration Token (starts with "pit-"). Create it in
# GHL → Settings → Private Integrations with the Voice AI read + write scopes.
# SECRET — real value only in .env / Secret Manager (secret: ghl-pit), never here.
GHL_PIT=pit-replace_me
# The FCI sub-account (location) ID that owns the Voice AI agents.
GHL_LOCATION_ID=replace_me
# Voice AI API version header (leave as v3 unless GHL changes it).
GHL_VOICE_API_VERSION=v3

# SMTP via Auragentics Google Workspace (used when EMAIL_MODE=smtp).
# Requires 2-Step Verification on the sending account + an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=brianlrandall@auragentics.ai
SMTP_PASS=
# From ADDRESS — must be a verified "send as" alias on SMTP_USER's account.
# The From NAME is set per type in code (records vs lien).
SMTP_FROM=noreply@auragentics.ai
